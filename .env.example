ARK_API_KEY=填写实际密钥
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=填写已开通的模型ID
EMBED_MODEL=填写已开通的向量模型ID
# 豆包语音服务：ASR（流式语音识别 2.0）和 TTS（语音合成 2.0）
# 在语音服务控制台获取 API Key；不要填写 ARK_API_KEY 的值，除非该密钥也获语音服务授权。
VOICE_API_KEY=填写语音服务API_Key
VOICE_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOICE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOICE_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOICE_TTS_RESOURCE_ID=seed-tts-2.0
VOICE_TTS_SPEAKER=zh_female_vv_uranus_bigtts
TOP_K=5
REQUEST_TIMEOUT=30
CHECKPOINT_PATH=var/checkpoints.sqlite3
INDEX_PATH=var/knowledge_index
# VECTOR_MAX_DISTANCE=1.2  # 仅为本地演示校准值；更换资料或模型后重新校准
LOG_LEVEL=INFO
SERVICE_API_KEY=
# SERVICE_CLIENTS_JSON={"analyst":{"api_key":"替换为随机密钥","scopes":["chat"]}}
MAX_BODY_BYTES=16384
RATE_LIMIT_PER_MINUTE=60
